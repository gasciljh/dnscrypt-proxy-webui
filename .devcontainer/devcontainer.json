// ============================================================
// DNSCrypt Smart Filter — Dev Container Configuration
// Version: v1.6.0 (Global Edition)
// Last updated: 2026-11-13
// ============================================================
// Reproducible VS Code Dev Container for the project.
//
// Note: VSCode's devcontainer.json parser accepts `//` line
// comments (JSONC-style) — the header below is valid.
//
// On container creation:
//   1. Minimal Ubuntu 22.04 image is pulled.
//   2. Go 1.22, GitHub CLI, and common-utils are installed
//      as devcontainer features.
//   3. .devcontainer/setup.sh runs as postCreateCommand to
//      install the full toolchain (shellcheck, shfmt,
//      golangci-lint, yamllint, actionlint, pre-commit, etc.).
//   4. VS Code extensions are installed automatically.
//
// Usage:
//   code .
//   F1 → "Dev Containers: Reopen in Container"
//
// Features:
//   • devcontainers/go:v1          — Go 1.22
//   • devcontainers/github-cli:v1  — gh CLI
//   • devcontainers/common-utils:v2 — base utilities
//
// postCreateCommand:
//   Runs `.devcontainer/setup.sh` which installs:
//     shellcheck · shfmt · golangci-lint v2 · staticcheck ·
//     gosec · actionlint · yamllint · detect-secrets ·
//     pre-commit.
//
//   If it fails, re-run manually: `bash .devcontainer/setup.sh`
//
// remoteUser:
//   Runs as `vscode` (non-root). Tools that install into
//   $HOME (go binaries, pip user packages, pre-commit hooks)
//   are affected. Root-needing tools use sudo.
//
// ============================================================
// Module layout (v1.6.0)
// ============================================================
// The shell scripts the devcontainer validates live at the
// REPOSITORY ROOT, not under proxy/:
//
//   • Root shell scripts (10):
//       boot-mini.sh, functions.sh, customize.sh,
//       install_app.sh, service.sh, watchdog.sh, status.sh,
//       action.sh, uninstall.sh, post-fs-data.sh
//   • lib/*.sh (Layer 0, 6 modules):
//       lib/constants.sh, lib/fallbacks.sh, lib/process.sh,
//       lib/http.sh, lib/backup.sh, lib/firewall.sh
//   • proxy/ (8 files): main.go, go.mod, go.sum, build.sh,
//       dnscrypt-proxy.toml, dnscrypt-proxy.version,
//       webui.conf, app-apk.version
//
// ============================================================
// v1.6.0 additions:
//   • lib/*.sh (6 modules) added at repo root — covered by the
//     existing shellcheck / shfmt toolchain, no new devcontainer
//     feature or tool required.
//   • Makefile targets `check-boot-mini` and `check-consistency`
//     added — both shell-only, no new tool required.
//   • CI Step 9 extended (verifies lib/*.sh + 3-layer chain),
//     Step 10 moved (canonical _MONITORING_UI_PORT in
//     lib/constants.sh), Step 11 added (timezone + mtime sort +
//     make check-consistency) — all tool-neutral.
//   • ADR-0003 (Layered Bootstrap) EXTENDED from 2-layer to
//     3-layer model; see docs/adr/0003-layered-bootstrap.md
//     §Extension. No new ADR file.
//
// ============================================================
// v1.5.0 additions:
//   • Adds two root-level shell scripts:
//       boot-mini.sh (Layer 1 aggregator, ADR-0003)
//       install_app.sh (5-level pm install cascade)
//     Both are covered by the existing toolchain.
//   • Cross-references updated to the consolidated docs
//     (v1.5.0 merged 35 markdown files → 15).
//   • ADR-0007 and ADR-0008 were renumbered to ADR-0002 and
//     ADR-0003 respectively in v1.5.0 (see docs/MAP.md §5.1).
//     ADR-0003 was extended to a 3-layer model in v1.6.0.
//
// Cross-references:
//   • .devcontainer/setup.sh             — postCreateCommand
//   • .github/workflows/ci.yml           — CI matrix (Steps 1-11)
//   • .github/workflows/upgrade-test.yml — 42-scenario matrix
//   • .github/dependabot.yml §[3]        — devcontainer features
//   • docs/REFERENCE.md §1.4             — Layered Bootstrap (3-layer, v1.6.0)
//   • docs/REFERENCE.md §4               — backup reference
//   • docs/REFERENCE.md §4.6.5           — SNAP-*/ROT-* rules
//   • docs/GUIDE.md §8                   — recovery guide
//   • docs/adr/0002-external-dependency.md
//   • docs/adr/0003-layered-bootstrap.md — §Extension (3-layer)
//   • Makefile check-boot-mini           — local Layer 0/1/2 check
//   • Makefile check-consistency         — docs path/version check (v1.6.0)
//   • CHANGELOG.md                       — version history
// ============================================================
{
  "name": "DNSCrypt Smart Filter Dev",

  "author": "gasciljh",

  "repository": "https://github.com/gasciljh/dnscrypt-proxy-webui",

  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",

  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.22"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "installOhMyZsh": false,
      "upgradePackages": true
    }
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "timonwong.shellcheck",
        "foxundermoon.shell-format",
        "yzhang.markdown-all-in-one",
        "redhat.vscode-yaml",
        "streetsidesoftware.code-spell-checker",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "go.useLanguageServer": true,
        "go.lintTool": "golangci-lint",
        // `--fast` disables slow linters for editor-time feedback.
        // The full lint suite runs in CI + `make check-all`, so
        // editor-side latency stays under 500ms.
        "go.lintFlags": ["--fast"],
        "go.testFlags": ["-race", "-count=1"],
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "files.eol": "\n",
        // Note: `.editorconfig [*.md]` sets
        // `trim_trailing_whitespace = false` (Markdown uses
        // trailing spaces for line breaks). The
        // `editorconfig.editorconfig` extension overrides this
        // global setting per-file, so Markdown files are NOT
        // trimmed despite the global `true` below.
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "[go]": {
          "editor.defaultFormatter": "golang.go",
          "editor.insertSpaces": false
        },
        "[shellscript]": {
          "editor.defaultFormatter": "foxundermoon.shell-format",
          "editor.tabSize": 4
        },
        "[yaml]": {
          "editor.tabSize": 2
        },
        "[json]": {
          "editor.tabSize": 2
        },
        "[jsonc]": {
          "editor.tabSize": 2
        },
        "[markdown]": {
          "editor.tabSize": 2,
          "editor.wordWrap": "on"
        },
        "shellcheck.enable": true,
        "shellcheck.run": "onType",
        "shellcheck.severity": "warning"
      }
    }
  },

  "remoteUser": "vscode",

  "containerEnv": {
    "PROJECT_URL": "https://github.com/gasciljh/dnscrypt-proxy-webui",
    "GOFLAGS": "-buildvcs=false -trimpath"
  }
}