// ============================================================
// DNSCrypt Smart Filter — Dev Container Configuration
// Version: v1.5.0 (Global Edition)
// Last updated: 2026-10-19
// ============================================================
// Reproducible VS Code Dev Container for the project.
//
// On container creation:
//   1. Minimal Ubuntu 22.04 image is pulled.
//   2. Go 1.22, GitHub CLI, and common-utils are installed
//      as devcontainer features.
//   3. .devcontainer/setup.sh runs as postCreateCommand to
//      install the full toolchain (shellcheck, shfmt,
//      golangci-lint, yamllint, actionlint, pre-commit, etc.).
//   4. VS Code extensions are installed automatically.
//
// Usage:
//   code .
//   F1 → "Dev Containers: Reopen in Container"
//
// Features:
//   • devcontainers/go:v1          — Go 1.22
//   • devcontainers/github-cli:v1  — gh CLI
//   • devcontainers/common-utils:v2 — base utilities
//
// postCreateCommand:
//   Runs `.devcontainer/setup.sh` which installs:
//     shellcheck · shfmt · golangci-lint v2 · staticcheck ·
//     gosec · actionlint · yamllint · detect-secrets ·
//     pre-commit.
//
//   If it fails, re-run manually: `bash .devcontainer/setup.sh`
//
// remoteUser:
//   Runs as `vscode` (non-root). Tools that install into
//   $HOME (go binaries, pip user packages, pre-commit hooks)
//   are affected. Root-needing tools use sudo.
//
// v1.5.0 additions:
//   • No new feature or tool. v1.5.0 adds two shell scripts
//     (boot-mini.sh, install_app.sh) covered by the existing
//     toolchain.
//   • Cross-references updated to the consolidated docs
//     (v1.5.0 merged 35 markdown files → 15).
//   • ADR-0007 and ADR-0008 were renumbered to ADR-0002 and
//     ADR-0003 respectively in v1.5.0 (see docs/MAP.md §5.1).
//
// Cross-references:
//   • .devcontainer/setup.sh             — postCreateCommand
//   • .github/workflows/ci.yml           — CI matrix
//   • .github/workflows/upgrade-test.yml — 42-scenario matrix
//   • .github/dependabot.yml §[3]        — devcontainer features
//   • docs/REFERENCE.md §4               — backup reference
//   • docs/GUIDE.md §8                   — recovery guide
//   • docs/REFERENCE.md §3               — v1.3.0 SNAP-*/ROT-*
//   • CHANGELOG.md                       — version history
// ============================================================
{
  "name": "DNSCrypt Smart Filter Dev",

  "author": "gasciljh",

  "repository": "https://github.com/gasciljh/dnscrypt-proxy-webui",

  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",

  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.22"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "installOhMyZsh": false,
      "upgradePackages": true
    }
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "timonwong.shellcheck",
        "foxundermoon.shell-format",
        "yzhang.markdown-all-in-one",
        "redhat.vscode-yaml",
        "streetsidesoftware.code-spell-checker",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "go.useLanguageServer": true,
        "go.lintTool": "golangci-lint",
        "go.lintFlags": ["--fast"],
        "go.testFlags": ["-race", "-count=1"],
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "files.eol": "\n",
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "[go]": {
          "editor.defaultFormatter": "golang.go",
          "editor.insertSpaces": false
        },
        "[shellscript]": {
          "editor.defaultFormatter": "foxundermoon.shell-format",
          "editor.tabSize": 4
        },
        "[yaml]": {
          "editor.tabSize": 2
        },
        "[json]": {
          "editor.tabSize": 2
        },
        "[jsonc]": {
          "editor.tabSize": 2
        },
        "[markdown]": {
          "editor.tabSize": 2,
          "editor.wordWrap": "on"
        },
        "shellcheck.enable": true,
        "shellcheck.run": "onType",
        "shellcheck.severity": "warning"
      }
    }
  },

  "remoteUser": "vscode",

  "containerEnv": {
    "PROJECT_URL": "https://github.com/gasciljh/dnscrypt-proxy-webui",
    "GOFLAGS": "-buildvcs=false -trimpath"
  }
}