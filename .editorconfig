# ============================================================
# EditorConfig for DNSCrypt Smart Filter
# Version: v1.5.0 (Global Edition)
# Last updated: 2026-10-15
# Author: gasciljh
# Repository: https://github.com/gasciljh/dnscrypt-proxy-webui
# Reference: https://editorconfig.org
# ============================================================
# Purpose:
#   Unifies file formatting across different editors.
#   Supported by: VS Code, IntelliJ, Vim, Emacs, Sublime, ...
#
# Scope:
#   Rules are defined only for file types that actually exist
#   in this repository. No speculative or defensive patterns.
#
# Note on indent_size:
#   When indent_style = tab, editors ignore the numeric
#   indent_size value. Setting it would be misleading, so it
#   is intentionally omitted in tab-indented sections.
# ============================================================

root = true

# ============================================================
# Defaults
# ============================================================
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ============================================================
# Go
# ============================================================
[*.go]
indent_style = tab

# ============================================================
# Shell scripts
# ============================================================
[*.{sh,bash}]
indent_style = space
indent_size = 4
switch_case_indent = true

# ============================================================
# JavaScript / JSON
# ============================================================
[*.{js,json}]
indent_style = space
indent_size = 2

# ============================================================
# YAML
# ============================================================
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# ============================================================
# Markdown
# ============================================================
# trim_trailing_whitespace = false is deliberate: two trailing
# spaces force a line break (<br>) in some Markdown dialects.
# ============================================================
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# ============================================================
# HTML / CSS / SVG
# ============================================================
[*.{html,css,scss,svg}]
indent_style = space
indent_size = 2

# ============================================================
# Makefile
# ============================================================
# Recipes require tabs — hard rule of GNU Make.
[Makefile]
indent_style = tab

# ============================================================
# TOML / Conf / Prop
# ============================================================
[*.{toml,conf,prop}]
indent_style = space
indent_size = 2

# ============================================================
# Go mod
# ============================================================
# Formatting is enforced by the `go mod` tooling.
[{go.mod,go.sum}]
indent_style = tab

# ============================================================
# Dockerfile
# ============================================================
[Dockerfile*]
indent_style = space
indent_size = 4

# ============================================================
# Pre-commit config
# ============================================================
[.pre-commit-config.yaml]
indent_style = space
indent_size = 2

# ============================================================
# LICENSE
# ============================================================
[LICENSE]
indent_style = space
indent_size = 4

# ============================================================
# Version files (single-line, no trailing whitespace)
# ============================================================
[VERSION]
insert_final_newline = true
trim_trailing_whitespace = true

[proxy/dnscrypt-proxy.version]
insert_final_newline = true
trim_trailing_whitespace = true

[proxy/app-apk.version]
insert_final_newline = true
trim_trailing_whitespace = true

# ============================================================
# Runtime files (proxy/run/)
# ============================================================
[proxy/run/*.status]
insert_final_newline = false

[proxy/run/*.pid]
insert_final_newline = false

[proxy/run/.bootstrap_cache]
insert_final_newline = false

# ============================================================
# Atomic-write temp files
# ============================================================
[*.tmp_*]
insert_final_newline = false

[proxy/run/*.tmp_*]
insert_final_newline = false

# ============================================================
# Binary assets
# ============================================================
[web/*.png]
insert_final_newline = false

[web/*.ico]
insert_final_newline = false

[web/*.apk]
insert_final_newline = false
trim_trailing_whitespace = false
end_of_line = unset

# ============================================================
# CI workflows
# ============================================================
[.github/workflows/*.yml]
indent_style = space
indent_size = 2
