# ============================================================
# Git Attributes for DNSCrypt Smart Filter
# Version: v1.6.0 (Global Edition)
# Last updated: 2026-11-13
# Author: gasciljh
# Repository: https://github.com/gasciljh/dnscrypt-proxy-webui
# Reference: https://git-scm.com/docs/gitattributes
# ============================================================
# Purpose:
#   Applies Git rules automatically for each file type.
# ============================================================

# ============================================================
# Default
# ============================================================
* text=auto eol=lf

# ============================================================
# Shell scripts
# ============================================================
*.sh            text eol=lf
*.bash          text eol=lf
action.sh       text eol=lf
customize.sh    text eol=lf
functions.sh    text eol=lf
post-fs-data.sh text eol=lf
service.sh      text eol=lf
status.sh       text eol=lf
uninstall.sh    text eol=lf
watchdog.sh     text eol=lf
install_app.sh  text eol=lf
boot-mini.sh    text eol=lf

# ============================================================
# Go
# ============================================================
*.go            text eol=lf
go.mod          text eol=lf
go.sum          text eol=lf

# ============================================================
# Web
# ============================================================
*.html          text eol=lf
*.css           text eol=lf
*.js            text eol=lf
*.json          text eol=lf
*.svg           text eol=lf

# ============================================================
# Config
# ============================================================
*.toml          text eol=lf
*.conf          text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.md            text eol=lf
module.prop     text eol=lf
VERSION         text eol=lf
Makefile        text eol=lf

# ============================================================
# Single-line version files
# ============================================================
proxy/dnscrypt-proxy.version  text eol=lf
proxy/app-apk.version         text eol=lf

# ============================================================
# Binary files (no conversion, no diff, no merge)
# ============================================================
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.pdf           binary
*.zip           binary
*.gz            binary
*.tar           binary
*.tar.gz        binary
*.7z            binary

dnscrypt-webui* binary
dnscrypt-proxy  binary

proxy/run/*.status         binary
proxy/run/*.pid            binary
proxy/run/*.tmp            binary
proxy/run/*.tmp_*          binary
proxy/run/.bootstrap_cache binary

*.tmp_*                    binary

# ============================================================
# Diff behavior
# ============================================================
*.md            diff=markdown
*.go            diff=golang
*.sh            diff=bash

checksums.txt   -diff

# ============================================================
# Merge Strategy
# ============================================================
*.zip              merge=binary
*.gz               merge=binary
*.png              merge=binary
*.svg              merge=binary

proxy/run/*.status         merge=binary
proxy/run/.bootstrap_cache merge=binary

# ============================================================
# Merge Strategy — Text files
# ============================================================
CHANGELOG.md  merge=union
VERSION       merge=binary

# ============================================================
# Linguist (GitHub language detection)
# ============================================================
docs/**       linguist-documentation
*.md          linguist-documentation
*.txt         linguist-documentation

*.sh          linguist-language=Shell
*.html        linguist-language=HTML
web/sw.js     linguist-language=JavaScript
.github/**    linguist-detectable=false

# ============================================================
# Export-ignore (not included in `git archive`)
# ============================================================
.github/                export-ignore
.gitignore              export-ignore
.gitattributes          export-ignore
.editorconfig           export-ignore
.pre-commit-config.yaml export-ignore
.secrets.baseline       export-ignore
.shellcheckrc           export-ignore
docs/                   export-ignore
scripts/                export-ignore
.devcontainer/          export-ignore
Makefile                export-ignore
build/                  export-ignore
dist/                   export-ignore
*.md                    export-ignore
proxy/build.sh          export-ignore
proxy/run/              export-ignore