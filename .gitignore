# ============================================================
# Git Ignore for DNSCrypt Smart Filter
# Version: v1.5.0 (Global Edition)
# Last updated: 2026-10-18
# Author: gasciljh
# Repository: https://github.com/gasciljh/dnscrypt-proxy-webui
# ============================================================
# Purpose:
#   Prevents build artifacts, runtime files, secrets, and IDE
#   files from being accidentally committed.
#
# Scope:
#   Patterns are defined only for file types that actually
#   exist or are created by this repository at runtime.
#
# Reminder:
#   If you add a new pattern here, add a matching exclusion in
#   .gitattributes if the file is binary, or a matching section
#   in .editorconfig if it has specific formatting rules.
# ============================================================

# ============================================================
# [1] Build artifacts
# ============================================================
build/
proxy/build/
dist/
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.sha256
*.sarif
/.codeql-analyze
proxy/.codeql-analyze

# ============================================================
# [2] WebUI binaries
# ============================================================
proxy/dnscrypt-webui-*
proxy/dnscrypt-webui
dnscrypt-webui-*

# ============================================================
# [3] Runtime directory (proxy/run/)
# ============================================================
proxy/run/*

# ============================================================
# [4] Runtime files (fallback locations)
# ============================================================
*.pid
*.status
*.tmp
*.tmp_*
*.tmp-*
*.log
*.old
*.emergency.*

# ============================================================
# [5] Log rotation artifacts
# ============================================================
*.log.*.gz
*.log.*.old
*.log.emergency.*

# ============================================================
# [6] Bootstrap cache
# ============================================================
.bootstrap_cache

# ============================================================
# [7] User configs
# ============================================================
# Runtime downloads + user-edited files.
#
# Note: proxy/webui.conf and proxy/dnscrypt-proxy.toml are
# template files that ship with the module and MUST be tracked.
# ============================================================
proxy/allowlist.txt
proxy/denylist.txt
proxy/blocklist.txt
proxy/blocklist.raw
proxy/selected_profile.txt
proxy/credentials.txt
proxy/blocked-ips.txt

# ============================================================
# [8] Go build artifacts
# ============================================================
*.test
*.exe
*.exe~
*.dll
*.so
*.dylib
__debug_bin*
__debug_bin*.exe

# ============================================================
# [9] Development scratch
# ============================================================
.scratch/

# ============================================================
# [10] Package build artifacts
# ============================================================
*.filelist.txt
.filelist.txt
*.tmp-*.zip

# ============================================================
# [11] OS files
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
*.swp

# ============================================================
# [12] IDE / Editor
# ============================================================
# .vscode/* (not .vscode/) so the negation below can re-include
# settings.json.example. Git cannot re-include a file when its
# parent directory is excluded.
# ============================================================
.vscode/*
!.vscode/settings.json.example
.idea/
*.iml
*.swo
*.swn
*~
*.bak
*.orig
*.rej

# ============================================================
# [13] Secrets & credentials (defensive)
# ============================================================
# None of these files exist in the repository today. The
# patterns guard against a contributor accidentally committing
# a real secret.
#
# Note: .secrets.baseline is NOT ignored — it is the
# detect-secrets baseline and must be tracked.
# ============================================================
.secrets
*.pem
*.key
*.pfx
*.p12
*.jks
*.keystore
*.credentials
*.secret

# ============================================================
# [14] Local overrides
# ============================================================
*.local
local.conf
local.toml
webui.conf.local

# ============================================================
# [15] Pre-commit cache
# ============================================================
.pre-commit-cache/
.cache/

# ============================================================
# [16] Devcontainer cache
# ============================================================
.devcontainer/.cache/
.devcontainer/**/node_modules/

# ============================================================
# [17] Documentation build
# ============================================================
docs/_build/
docs/.cache/
site/

# ============================================================
# [18] Misc
# ============================================================
*.cache
*.pid.tmp

# ============================================================
# [19] Data-preservation test artifacts (v1.2.0)
# ============================================================
# Manual test files created by developers. Not created by any
# script during normal operation.
#
# The real backup directory on the device —
# /sdcard/dnscrypt-webui-backup/ — lives OUTSIDE the
# repository and is NOT listed here.
# ============================================================
.scratch/dnscrypt-backup-test/
.scratch/dnscrypt-txn-test/
.scratch/dnscrypt-upgrade-backup-*
.scratch/dnscrypt-backup-manual/

*.manifest.json.tmp
*.upgrade_history.json.tmp
*.manifest.json.tmp_*
*.upgrade_history.json.tmp_*

txn-*/
orphan-txn-*/

# ============================================================
# [20] Companion Android app APK (v1.4.0)
# ============================================================
# web/app-debug.apk is staged by release.yml before packaging
# and copied into the module ZIP. It is a build artifact.
#
# The `*.apk` pattern also covers `dist/DNS-Proxy-*.apk` and any
# other APK that might land in the repository by accident.
# ============================================================
*.apk

# ============================================================
# [21] DNS binaries
# ============================================================
# proxy/dnscrypt-proxy.toml and proxy/dnscrypt-proxy.version
# are TRACKED files. The patterns below use full filenames,
# so neither is matched.
# ============================================================
proxy/dnscrypt-proxy-arm64
proxy/dnscrypt-proxy-arm
proxy/dnscrypt-proxy-x86_64
proxy/dnscrypt-proxy-x86