#!/sbin/sh
# ============================================================
# DNSCrypt Smart Filter — update-binary
# Version: v1.6.0 (Global Edition)
# Last updated: 2026-11-13
# ============================================================
# Magisk / KernelSU / APatch module installer entry point.
#
# Invoked by the root manager when the user selects the
# module ZIP for installation. Delegates to `customize.sh`
# (the real installer — 10 data-preservation layers).
#
# Arguments (provided by Magisk):
#   $1 = unused
#   $2 = OUTFD    (file descriptor for the install log UI)
#   $3 = ZIPFILE  (absolute path to the module ZIP)
#
# Execution flow:
#   1. umask 022 for consistent file permissions.
#   2. Fallback ui_print before util_functions is loaded.
#   3. Verify Magisk >= 20.4 is installed.
#   4. Mount /data, source util_functions.sh, call install_module.
#
# Compatibility: Magisk 20.4+, KernelSU, APatch.
#
# ⚠️ Standard Magisk boilerplate. Body unchanged since v1.0.0.
#    All DNSCrypt logic lives in `customize.sh` at the repo
#    root — the update-binary only hands control to it.
#
# ============================================================
# Module layout (v1.6.0)
# ============================================================
# The shell scripts invoked during installation are at the
# REPOSITORY ROOT, not under proxy/:
#   • customize.sh  — extraction, transaction, restore
#   • functions.sh  — Layer 2 orchestrator (sources boot-mini.sh)
#   • boot-mini.sh  — Layer 1 aggregator (sources lib/*.sh)
#   • uninstall.sh  — uninstall handler
#   • lib/*.sh      — Layer 0 (6 modules, 0644, sourced)
#
#   customize.sh itself sets SKIPUNZIP=1 in §[2], so Magisk's
#   install_module() extracts only module.prop + customize.sh,
#   then hands control to customize.sh for the rest of the
#   extraction (including lib/*.sh, install_app.sh, and
#   boot-mini.sh) via its own `unzip -o "$ZIPFILE" ...` call
#   in §[12].
#
# ============================================================
# v1.6.0 additions:
#   • No change to the body — Magisk's util_functions.sh and
#     install_module() are unchanged in v1.6.0.
#   • The 3-layer shell model (lib/*.sh → boot-mini.sh →
#     functions.sh) is set up by customize.sh §[12], not here.
#   • Cross-references fixed: shell scripts live at the repo
#     root, not under proxy/ (RC-1 correction).
#
# Cross-references:
#   • customize.sh                      — actual installer
#   • functions.sh                      — shared library (Layer 2)
#   • boot-mini.sh                      — Layer 1 aggregator
#   • lib/*.sh                          — Layer 0 (6 modules)
#   • uninstall.sh                      — uninstall handler
#   • docs/REFERENCE.md §1.8.2          — repository layout
#   • docs/REFERENCE.md §4              — backup system reference
#   • docs/GUIDE.md §2                  — installation guide
# ============================================================

#################
# Initialization
#################

umask 022

# echo before loading util_functions
ui_print() { echo "$1"; }

require_new_magisk() {
  ui_print "*******************************"
  ui_print " Please install Magisk v20.4+! "
  ui_print "*******************************"
  exit 1
}

#########################
# Load util_functions.sh
#########################

OUTFD=$2
ZIPFILE=$3

mount /data 2>/dev/null

[ -f /data/adb/magisk/util_functions.sh ] || require_new_magisk
. /data/adb/magisk/util_functions.sh
[ $MAGISK_VER_CODE -lt 20400 ] && require_new_magisk

install_module
exit 0