# versionCode formula (maintained by scripts/release.sh):
#   MAJOR × 1,000,000 + MINOR × 10,000 + PATCH × 100
# ============================================================

id=dnscrypt-proxy-webui
name=DNSCrypt Proxy (Smart Filter)
